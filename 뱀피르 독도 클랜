    <script>
        function toggleMobileMenu() {
            const sidebar = document.getElementById('sidebar');
            if (sidebar.classList.contains('hidden')) {
                sidebar.classList.remove('hidden');
                sidebar.classList.add('flex', 'absolute', 'z-50', 'w-full', 'h-full', 'bg-gray-900');
            } else {
                sidebar.classList.add('hidden');
                sidebar.classList.remove('flex', 'absolute', 'z-50', 'w-full', 'h-full', 'bg-gray-900');
            }
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('aside nav button').forEach(btn => {
                btn.classList.remove('bg-red-600', 'text-white');
                btn.classList.add('text-gray-300');
            });

            document.getElementById('tab-' + tabId).classList.remove('hidden');
            const activeBtn = document.getElementById('nav-' + tabId);
            if (activeBtn) {
                activeBtn.classList.remove('text-gray-300');
                activeBtn.classList.add('bg-red-600', 'text-white');
            }
            if(tabId === 'dia') {
                calculateDiaDistribution();
            }

            // 모바일에서 메뉴를 누르면 자동으로 메뉴 닫기
            const sidebar = document.getElementById('sidebar');
            if (window.innerWidth < 768 && !sidebar.classList.contains('hidden')) {
                toggleMobileMenu();
            }
        }

        function getTodayStr() {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        const BASE_MATCH_START = new Date('2026-08-19T00:00:00'); 

        function getSeasonStartAndEnd(dateStr) {
            const targetDate = new Date(dateStr + 'T00:00:00');
            const diffTime = targetDate.getTime() - BASE_MATCH_START.getTime();
            const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
            
            const seasonIndex = Math.floor(diffDays / 14);

            let currentStart = new Date(BASE_MATCH_START.getTime());
            currentStart.setDate(currentStart.getDate() + (seasonIndex * 14));

            let currentEnd = new Date(currentStart.getTime());
            currentEnd.setDate(currentEnd.getDate() + 13);

            const formatDate = (d) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
            
            return {
                seasonName: `${formatDate(currentStart)} ~ ${formatDate(currentEnd)}`,
                startDateObj: currentStart,
                endDateObj: currentEnd,
                startDate: formatDate(currentStart),
                endDate: formatDate(currentEnd)
            };
        }

        function resetTodayAttendance() {
            if(confirm("정말 오늘 출석 기록을 전부 초기화하시겠습니까? (복구 불가능)")) {
                const today = getTodayStr();
                attendanceLogs = attendanceLogs.filter(log => log.date !== today);
                saveAndRenderAttendance();
                alert("오늘 출석 기록이 모두 초기화되었습니다.");
            }
        }

        function checkAndUpdateDate() {
            const todayStr = getTodayStr();
            const dateEl = document.getElementById('dashboard-date');
            if (dateEl && dateEl.innerText !== todayStr) {
                dateEl.innerText = todayStr;
            }

            const seasonInfo = getSeasonStartAndEnd(todayStr);
            const seasonInfoEl = document.getElementById('current-season-info');
            if(seasonInfoEl) {
                seasonInfoEl.innerText = `현재 서버 매칭 시즌: ${seasonInfo.seasonName} (2주 단위 자동 적용 중)`;
            }
        }

        let bossList = [
            { name: "12시 월드보스", time: "11:55", alarmOn: true },
            { name: "13시 게헨나 보스", time: "12:55", alarmOn: true },
            { name: "20시 월드보스", time: "19:55", alarmOn: true },
            { name: "21시 게헨나 보스", time: "20:55", alarmOn: true }
        ];

        function renderBossTimer() {
            const container = document.getElementById('boss-container');
            if(!container) return;
            container.innerHTML = '';

            const now = new Date();
            
            bossList.forEach((boss, index) => {
                const [bHour, bMin] = boss.time.split(':').map(Number);
                let target = new Date();
                target.setHours(bHour, bMin, 0, 0);

                let diff = target.getTime() - now.getTime();
                let isPassed = false;
                if (diff < 0) {
                    isPassed = true;
                    diff += 24 * 60 * 60 * 1000;
                }

                const hours = Math.floor(diff / (1000 * 60 * 60));
                const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((diff % (1000 * 60)) / 1000);

                let timeStr = `${hours}시간 ${minutes}분 ${seconds}초 전`;
                if (isPassed) {
                    timeStr = `남은 시간: ${hours}시간 ${minutes}분 ${seconds}초`;
                }

                if (diff >= 299000 && diff <= 301000 && seconds === 0 && boss.alarmOn) {
                    speakBossAlert(boss.name);
                }

                container.innerHTML += `
                    <div class="bg-gray-900 border border-gray-800 p-5 rounded-xl space-y-4 shadow">
                        <p class="text-gray-400 text-center text-xs font-semibold">${boss.name}</p>
                        <p class="text-white text-center text-2xl font-bold">${boss.time}</p>
                        <p class="text-blue-400 text-center text-xs font-mono">${timeStr}</p>
                        <div class="flex justify-between items-center pt-3 border-t border-gray-800 text-xs text-gray-400">
                            <span>알람 설정</span>
                            <button onclick="toggleBossAlarm(${index})" class="px-3 py-1 rounded font-bold text-white transition ${boss.alarmOn ? 'bg-green-600 hover:bg-green-500' : 'bg-gray-700 hover:bg-gray-600'}">
                                ${boss.alarmOn ? 'ON' : 'OFF'}
                            </button>
                        </div>
                    </div>
                `;
            });
        }

        function toggleBossAlarm(index) {
            bossList[index].alarmOn = !bossList[index].alarmOn;
            renderBossTimer();
            updateGlobalStatus();
        }

        function setAllAlarm(status) {
            bossList.forEach(b => b.alarmOn = status);
            renderBossTimer();
            updateGlobalStatus();
        }

        function updateGlobalStatus() {
            const allOn = bossList.every(b => b.alarmOn);
            const statusEl = document.getElementById('global-alarm-status');
            if(statusEl) {
                statusEl.innerText = allOn ? "전체 알람 켜짐" : "일부 알람 꺼짐/켜짐";
                statusEl.className = allOn ? "bg-green-600 text-white text-xs px-2.5 py-1 rounded-full font-bold" : "bg-yellow-600 text-white text-xs px-2.5 py-1 rounded-full font-bold";
            }
        }

        function speakBossAlert(bossName) {
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance(`${bossName} 알람 시간입니다.`);
                utterance.lang = 'ko-KR';
                window.speechSynthesis.speak(utterance);
            }
        }

        function testVoice() {
            speakBossAlert("20시 월드보스");
        }

        let attendanceLogs = JSON.parse(localStorage.getItem('vampirAttendanceLogs')) || [];
        let vaultItems = JSON.parse(localStorage.getItem('vampirVaultItems')) || [];

        function checkAttendance(slotKey, groupName, buttonLabel) {
            const nicknameInput = document.getElementById('att-nickname');
            const nickname = nicknameInput.value.trim();
            if(!nickname) {
                alert('닉네임을 먼저 입력해주세요!');
                nicknameInput.focus();
                return;
            }

            const today = getTodayStr();
            const now = new Date();
            const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

            const alreadyExists = attendanceLogs.some(log => log.date === today && log.nickname === nickname && log.slotKey === slotKey);
            if (alreadyExists) {
                alert(`[${nickname}]님은 오늘 이미 '${buttonLabel}' 항목을 체크하셨습니다.`);
                return;
            }

            attendanceLogs.push({
                date: today,
                nickname: nickname,
                slotKey: slotKey,
                groupName: groupName,
                buttonLabel: buttonLabel,
                time: timeStr
            });

            saveAndRenderAttendance();
            alert(`[${nickname}]님의 '${buttonLabel}' 출석이 완료되었습니다! (${timeStr})`);
        }

        function saveAndRenderAttendance() {
            localStorage.setItem('vampirAttendanceLogs', JSON.stringify(attendanceLogs));
            renderAttendance();
        }

        function calculateDayScore(logsForDay) {
            let memberDaySummary = {};
            logsForDay.forEach(log => {
                if(!memberDaySummary[log.nickname]) {
                    memberDaySummary[log.nickname] = {
                        '13시_시작전': false, '13시_3층전': false, '13시_끝': false,
                        '21시_시작전': false, '21시_3층전': false, '21시_끝': false,
                        special: { '에노크': false, '마슈미드': false },
                        war: { '점령전': false, '전초전': false, '쟁탈전': false },
                        mission: { '클랜임무': false, '클랜수호': false }
                    };
                }
                if(log.groupName === '13시타임' || log.groupName === '21시타임') {
                    memberDaySummary[log.nickname][log.slotKey] = true;
                } else if(log.groupName === 'special') {
                    memberDaySummary[log.nickname].special[log.slotKey] = true;
                } else if(log.groupName === 'war') {
                    memberDaySummary[log.nickname].war[log.slotKey] = true;
                } else if(log.groupName === 'mission') {
                    memberDaySummary[log.nickname].mission[log.slotKey] = true;
                }
            });

            let scores = {};
            Object.keys(memberDaySummary).forEach(nick => {
                const sum = memberDaySummary[nick];
                let c13 = (sum['13시_시작전'] && sum['13시_3층전'] && sum['13시_끝']) ? 1 : 0;
                let c21 = (sum['21시_시작전'] && sum['21시_3층전'] && sum['21시_끝']) ? 1 : 0;
                let specialSet = (sum.special['에노크'] && sum.special['마슈미드']) ? 1 : 0;
                let warSet = (sum.war['점령전'] && sum.war['전초전'] && sum.war['쟁탈전']) ? 1 : 0;
                let missionSet = (sum.mission['클랜임무'] && sum.mission['클랜수호']) ? 1 : 0;

                scores[nick] = c13 + c21 + specialSet + warSet + missionSet;
            });
            return scores;
        }

        function renderAttendance() {
            const today = getTodayStr();
            const currentSeason = getSeasonStartAndEnd(today);

            const currentSeasonLogs = attendanceLogs.filter(log => {
                const logSeason = getSeasonStartAndEnd(log.date);
                return logSeason.seasonName === currentSeason.seasonName;
            });

            const todayLogs = currentSeasonLogs.filter(log => log.date === today);

            let seasonTotalScores = {};
            let seasonDaysMap = {};
            currentSeasonLogs.forEach(log => {
                if(!seasonDaysMap[log.date]) seasonDaysMap[log.date] = [];
                seasonDaysMap[log.date].push(log);
            });

            Object.keys(seasonDaysMap).forEach(date => {
                let dayScores = calculateDayScore(seasonDaysMap[date]);
                Object.keys(dayScores).forEach(nick => {
                    seasonTotalScores[nick] = (seasonTotalScores[nick] || 0) + dayScores[nick];
                });
            });

            let memberMap = {};
            todayLogs.forEach(log => {
                if(!memberMap[log.nickname]) {
                    memberMap[log.nickname] = [];
                }
                memberMap[log.nickname].push(log);
            });

            const tbody = document.getElementById('attendance-table-body');
            if(!tbody) return;
            tbody.innerHTML = '';

            const nicknames = Object.keys(seasonTotalScores);
            if(nicknames.length === 0 && todayLogs.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="py-6 text-center text-gray-500">기록된 출석 데이터가 없습니다.</td></tr>`;
                document.getElementById('dashboard-total-rate').innerText = `0명 참여 중`;
                document.getElementById('dashboard-today-avg-rate').innerText = `(평균 참여율: 0.0%)`;
                return;
            }

            let allNicks = new Set([...Object.keys(memberMap), ...Object.keys(seasonTotalScores)]);
            let todayParticipantCount = 0;
            let totalTodayRateSum = 0;

            allNicks.forEach(nick => {
                let score = seasonTotalScores[nick] || 0;
                let rate = ((score / 42) * 100).toFixed(1);
                
                let todayLogsList = memberMap[nick] || [];
                let hasToday = todayLogsList.length > 0;
                if(hasToday) {
                    todayParticipantCount++;
                    totalTodayRateSum += Number(rate);
                }

                let c13Done = todayLogsList.some(l => l.groupName === '13시타임') ? '✅' : '❌';
                let specialDone = todayLogsList.some(l => l.groupName === 'special') ? '✅' : '❌';
                let warDone = todayLogsList.some(l => l.groupName === 'war') ? '✅' : '❌';
                let missionDone = todayLogsList.some(l => l.groupName === 'mission') ? '✅' : '❌';
                let details = todayLogsList.map(l => `${l.buttonLabel}(${l.time})`).join(', ') || '기록 없음';

                tbody.innerHTML += `
                    <tr class="border-b border-gray-800 text-gray-300">
                        <td class="py-3 px-2 font-bold text-white">${nick} <span class="text-xs text-amber-400">(${score}점 / ${rate}%)</span></td>
                        <td class="py-3 px-2">${hasToday ? '<span class="text-green-400 font-bold">참여 완료</span>' : '<span class="text-gray-500">미참여</span>'}</td>
                        <td class="py-3 px-2">${c13Done}</td>
                        <td class="py-3 px-2">${specialDone}</td>
                        <td class="py-3 px-2">${warDone}</td>
                        <td class="py-3 px-2">${missionDone}</td>
                        <td class="py-3 px-2 text-xs text-gray-400">${details}</td>
                    </tr>
                `;
            });

            document.getElementById('dashboard-total-rate').innerText = `${todayParticipantCount}명 참여 중`;
            let avgRate = todayParticipantCount > 0 ? (totalTodayRateSum / todayParticipantCount).toFixed(1) : '0.0';
            document.getElementById('dashboard-today-avg-rate').innerText = `(평균 참여율: ${avgRate}%)`;
            
            renderSeasonHistory(seasonDaysMap, seasonTotalScores);
        }

        function renderSeasonHistory(seasonDaysMap, seasonTotalScores) {
            const container = document.getElementById('season-history-container');
            if(!container) return;
            
            const dates = Object.keys(seasonDaysMap).sort().reverse();
            if(dates.length === 0) {
                container.innerHTML = `<p class="py-6 text-center text-gray-500">저장된 출석 기록이 없습니다.</p>`;
                return;
            }

            container.innerHTML = '';
            dates.forEach(date => {
                let dayScores = calculateDayScore(seasonDaysMap[date]);
                let participants = Object.keys(dayScores);
                
                let listHtml = participants.map(p => `<span class="bg-gray-800 px-2.5 py-1 rounded text-xs text-gray-200">${p} (${dayScores[p]}점)</span>`).join(' ');

                container.innerHTML += `
                    <div class="bg-gray-850 p-4 rounded-xl border border-gray-800 space-y-2">
                        <div class="flex justify-between items-center text-sm font-bold text-blue-400">
                            <span>📅 ${date} 출석 현황</span>
                            <span class="text-xs text-gray-400">총 ${participants.length}명 참여</span>
                        </div>
                        <div class="flex flex-wrap gap-2 pt-1">
                            ${listHtml || '<span class="text-xs text-gray-500">참여자 없음</span>'}
                        </div>
                    </div>
                `;
            });
        }

        function searchMemberHistory() {
            const keyword = document.getElementById('search-keyword').value.trim();
            const resultContainer = document.getElementById('search-result-container');
            if(!keyword) {
                alert('검색할 닉네임을 입력해주세요!');
                return;
            }

            const memberLogs = attendanceLogs.filter(log => log.nickname.includes(keyword));
            if(memberLogs.length === 0) {
                resultContainer.innerHTML = `<p class="text-red-400">['${keyword}']에 대한 출석 기록이 존재하지 않습니다.</p>`;
                return;
            }

            let html = `<p class="font-bold text-white mb-3">🔍 '${keyword}' 클랜원의 상세 참여 내역 (총 ${memberLogs.length}건)</p>`;
            html += `<div class="space-y-2 max-h-60 overflow-y-auto">`;
            memberLogs.slice().reverse().forEach(log => {
                html += `<div class="bg-gray-800 p-2.5 rounded text-xs flex justify-between text-gray-300">
                    <span>날짜: <strong class="text-blue-400">${log.date}</strong> | 항목: <strong class="text-amber-400">${log.buttonLabel}</strong></span>
                    <span class="text-gray-400">${log.time} 기록</span>
                </div>`;
            });
            html += `</div>`;
            resultContainer.innerHTML = html;
        }

        function addVaultItem() {
            const nameInput = document.getElementById('vault-name');
            const countInput = document.getElementById('vault-count');
            const memoInput = document.getElementById('vault-memo');

            const name = nameInput.value.trim();
            const count = parseInt(countInput.value) || 1;
            const memo = memoInput.value.trim();

            if(!name) {
                alert('아이템 이름을 입력해주세요!');
                nameInput.focus();
                return;
            }

            const existing = vaultItems.find(item => item.name === name);
            if(existing) {
                existing.count += count;
                if(memo) existing.memo = memo;
            } else {
                vaultItems.push({ name, count, memo });
            }

            saveAndRenderVault();
            nameInput.value = '';
            countInput.value = '1';
            memoInput.value = '';
            alert('금고 아이템이 등록/수정되었습니다.');
        }

        function adjustVaultCount(index, amount) {
            vaultItems[index].count += amount;
            if(vaultItems[index].count <= 0) {
                if(confirm(`'${vaultItems[index].name}' 아이템의 수량이 0이 되어 삭제됩니다.`)) {
                    vaultItems.splice(index, 1);
                } else {
                    vaultItems[index].count = 1;
                }
            }
            saveAndRenderVault();
        }

        function deleteVaultItem(index) {
            if(confirm(`정말 '${vaultItems[index].name}' 아이템을 금고에서 삭제하시겠습니까?`)) {
                vaultItems.splice(index, 1);
                saveAndRenderVault();
            }
        }

        function saveAndRenderVault() {
            localStorage.setItem('vampirVaultItems', JSON.stringify(vaultItems));
            renderVault();
        }

        function renderVault() {
            const tbody = document.getElementById('vault-table-body');
            if(!tbody) return;
            tbody.innerHTML = '';

            if(vaultItems.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-gray-500">등록된 금고 아이템이 없습니다.</td></tr>`;
                return;
            }

            vaultItems.forEach((item, index) => {
                tbody.innerHTML += `
                    <tr class="border-b border-gray-800 text-gray-300">
                        <td class="py-3 px-4 font-bold text-white">${item.name}</td>
                        <td class="py-3 px-4 text-amber-400 font-bold">${item.count}개</td>
                        <td class="py-3 px-4 text-xs text-gray-400">${item.memo || '-'}</td>
                        <td class="py-3 px-4 text-center space-x-2">
                            <button onclick="adjustVaultCount(${index}, 1)" class="bg-gray-800 hover:bg-gray-700 text-white px-2.5 py-1 rounded text-xs font-bold">+</button>
                            <button onclick="adjustVaultCount(${index}, -1)" class="bg-gray-800 hover:bg-gray-700 text-white px-2.5 py-1 rounded text-xs font-bold">-</button>
                            <button onclick="deleteVaultItem(${index})" class="bg-red-900 hover:bg-red-800 text-red-200 px-2.5 py-1 rounded text-xs font-bold">삭제</button>
                        </td>
                    </tr>
                `;
            });
        }

        function calculateDiaDistribution() {
            const totalDiaInput = document.getElementById('total-dia-input');
            const totalDia = parseInt(totalDiaInput.value) || 0;
            const tbody = document.getElementById('dia-table-body');
            if(!tbody) return;

            const today = getTodayStr();
            const currentSeason = getSeasonStartAndEnd(today);
            const currentSeasonLogs = attendanceLogs.filter(log => {
                const logSeason = getSeasonStartAndEnd(log.date);
                return logSeason.seasonName === currentSeason.seasonName;
            });

            let seasonTotalScores = {};
            let seasonDaysMap = {};
            currentSeasonLogs.forEach(log => {
                if(!seasonDaysMap[log.date]) seasonDaysMap[log.date] = [];
                seasonDaysMap[log.date].push(log);
            });

            Object.keys(seasonDaysMap).forEach(date => {
                let dayScores = calculateDayScore(seasonDaysMap[date]);
                Object.keys(dayScores).forEach(nick => {
                    seasonTotalScores[nick] = (seasonTotalScores[nick] || 0) + dayScores[nick];
                });
            });

            const nicknames = Object.keys(seasonTotalScores);
            if(nicknames.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-gray-500">현재 시즌에 누적된 출석 점수가 없습니다. 출석을 먼저 기록해주세요.</td></tr>`;
                return;
            }

            let totalScoreSum = 0;
            nicknames.forEach(nick => {
                totalScoreSum += seasonTotalScores[nick];
            });

            tbody.innerHTML = '';
            nicknames.forEach(nick => {
                let score = seasonTotalScores[nick];
                let rate = ((score / 42) * 100).toFixed(1);
                let assignedDia = totalScoreSum > 0 ? Math.floor((score / totalScoreSum) * totalDia) : 0;

                tbody.innerHTML += `
                    <tr class="border-b border-gray-800 text-gray-300">
                        <td class="py-3 px-4 font-bold text-white">${nick}</td>
                        <td class="py-3 px-4">${score}점</td>
                        <td class="py-3 px-4 text-blue-400">${rate}%</td>
                        <td class="py-3 px-4 text-amber-400 font-bold">${assignedDia.toLocaleString()} 다이아</td>
                    </tr>
                `;
            });
        }

        window.onload = function() {
            checkAndUpdateDate();
            renderBossTimer();
            renderAttendance();
            renderVault();
            setInterval(renderBossTimer, 1000);
        };
    </script>
</body>
</html>
