
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>뱀피르 독도 클랜 관리</title>
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Firebase SDK (v9 Compat) -->
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700;900&display=swap');
        body { background-color: #0b0f19; color: #f3f4f6; font-family: 'Noto Sans KR', sans-serif; -webkit-tap-highlight-color: transparent; }
        .dokdo-title { font-weight: 900; font-style: italic; background: linear-gradient(180deg, #fff, #64748b); -webkit-background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 0 10px rgba(239, 68, 68, 0.4)); }
        .card-bg { background: rgba(17, 24, 39, 0.95); backdrop-filter: blur(10px); border: 1px solid #1f2937; border-radius: 1.5rem; }
        input { outline: none; appearance: none; -webkit-appearance: none; border-radius: 0.75rem !important; }
        .hidden { display: none !important; }
        .pw-toggle { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); color: #4b5563; cursor: pointer; border: none; background: none; font-size: 1.2rem; }
    </style>
</head>
<body class="min-h-screen">

    <!-- 로그인/회원가입 섹션 -->
    <div id="auth-screen" class="fixed inset-0 z-[9999] flex items-center justify-center bg-[#0b0f19] p-4">
        <div class="card-bg w-full max-w-md p-8 space-y-6">
            <div class="text-center">
                <h1 class="dokdo-title text-5xl">DOKDO</h1>
                <p class="text-gray-500 text-xs mt-2 tracking-[0.2em] uppercase">Clan Management System</p>
            </div>

            <div class="flex border-b border-gray-800 text-sm font-bold">
                <button onclick="toggleAuth('login')" id="tab-login" class="flex-1 pb-3 text-red-500 border-b-2 border-red-500 transition-all">로그인</button>
                <button onclick="toggleAuth('reg')" id="tab-reg" class="flex-1 pb-3 text-gray-500 transition-all">회원가입</button>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-[10px] text-gray-500 mb-1 ml-1 uppercase">Nickname</label>
                    <input type="text" id="nickname" placeholder="게임 닉네임 입력" class="w-full bg-gray-900 border border-gray-700 p-3.5 text-sm focus:border-red-500 transition-all text-white">
                </div>
                <div>
                    <label class="block text-[10px] text-gray-500 mb-1 ml-1 uppercase">Password</label>
                    <div class="relative">
                        <input type="password" id="password" placeholder="비밀번호 입력" class="w-full bg-gray-900 border border-gray-700 p-3.5 pr-12 text-sm focus:border-red-500 transition-all text-white">
                        <button type="button" onclick="togglePw()" class="pw-toggle">👁️</button>
                    </div>
                </div>
                <button type="button" onclick="processAuth()" id="auth-btn" class="w-full bg-red-600 hover:bg-red-500 text-white font-bold p-4 rounded-2xl transition shadow-lg shadow-red-900/20 cursor-pointer mt-2">로그인하기</button>
            </div>
            <p id="auth-error" class="text-xs text-red-400 text-center min-h-[1.5rem] mt-2 font-bold"></p>
        </div>
    </div>

    <!-- 메인 대시보드 -->
    <div id="main-system" class="hidden flex flex-col md:flex-row min-h-screen">
        <aside class="w-full md:w-64 bg-gray-900 border-r border-gray-800 p-6 flex flex-col">
            <h1 class="dokdo-title text-2xl mb-8">DOKDO</h1>
            <nav class="flex-grow space-y-2">
                <button onclick="showTab('home')" class="w-full text-left p-3 rounded-xl hover:bg-gray-800 font-bold text-sm">📊 대시보드</button>
                <button id="admin-menu" onclick="showTab('admin')" class="hidden w-full text-left p-3 rounded-xl bg-red-900/20 text-red-400 font-bold text-sm border border-red-900/50">👑 운영진 관리</button>
            </nav>
            <div class="mt-auto pt-6 border-t border-gray-800">
                <p id="user-info" class="text-sm font-bold mb-4"></p>
                <button onclick="logout()" class="w-full py-3 bg-gray-800 rounded-xl text-xs font-bold text-red-400 cursor-pointer">로그아웃</button>
            </div>
        </aside>

        <main class="flex-grow p-6 md:p-10">
            <section id="tab-home" class="tab-content">
                <h2 class="text-3xl font-bold mb-6">대시보드</h2>
                <div class="card-bg p-6 border-l-4 border-red-600">
                    <h3 class="text-amber-400 font-bold mb-2">📢 오늘의 공지</h3>
                    <p id="notice-display" class="text-gray-300">공지사항을 불러오고 있습니다...</p>
                </div>
            </section>

            <section id="tab-admin" class="tab-content hidden">
                <h2 class="text-3xl font-bold mb-6 text-red-500">Admin Control</h2>
                <div class="card-bg p-6 space-y-4">
                    <h3 class="font-bold mb-2">공지사항 수정</h3>
                    <div class="flex gap-2">
                        <input type="text" id="notice-input" placeholder="새 공지사항 내용 입력" class="flex-grow bg-gray-900 border border-gray-700 p-3 text-sm text-white">
                        <button onclick="saveNotice()" class="bg-red-600 hover:bg-red-500 px-6 py-3 rounded-xl text-xs font-bold transition cursor-pointer">저장</button>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyBY2zXT1XH071ycsSop-_XFsuoALcFuzIc",
            authDomain: "vampire-dokdo.firebaseapp.com",
            projectId: "vampire-dokdo",
            storageBucket: "vampire-dokdo.firebasestorage.app",
            messagingSenderId: "428544566569",
            appId: "1:428544566569:web:0c566d18c2722fc9460338",
            measurementId: "G-JD98J0VHD2"
        };

        if (!firebase.apps.length) {
            firebase.initializeApp(firebaseConfig);
        }
        const auth = firebase.auth();
        const db = firebase.firestore();

        let currentMode = 'login';
        const V_DOMAIN = "@dokdo.com";

        function toggleAuth(mode) {
            currentMode = mode;
            document.getElementById('auth-btn').innerText = mode === 'login' ? '로그인하기' : '회원가입 완료';
            document.getElementById('tab-login').className = mode === 'login' ? "flex-1 pb-3 text-red-500 border-b-2 border-red-500" : "flex-1 pb-3 text-gray-500";
            document.getElementById('tab-reg').className = mode === 'reg' ? "flex-1 pb-3 text-red-500 border-b-2 border-red-500" : "flex-1 pb-3 text-gray-500";
            document.getElementById('auth-error').innerText = "";
        }

        function togglePw() {
            const pwInput = document.getElementById('password');
            pwInput.type = pwInput.type === 'password' ? 'text' : 'password';
        }

        async function processAuth() {
            const nick = document.getElementById('nickname').value.trim();
            const pw = document.getElementById('password').value.trim();
            const errorEl = document.getElementById('auth-error');

            errorEl.innerText = "";

            if(!nick || !pw) {
                errorEl.innerText = "닉네임과 비밀번호를 모두 입력해주세요.";
                return;
            }

            const vEmail = nick + V_DOMAIN;
            errorEl.innerText = "처리 중입니다...";

            try {
                if(currentMode === 'reg') {
                    const res = await auth.createUserWithEmailAndPassword(vEmail, pw);
                    // 가입 성공 시 DB에 바로 저장 (실패해도 로그인은 되도록 안전하게 처리)
                    db.collection('users').doc(res.user.uid).set({
                        uid: res.user.uid,
                        nickname: nick,
                        role: 'admin',
                        createdAt: firebase.firestore.FieldValue.serverTimestamp()
                    }).catch(err => console.log(err));
                } else {
                    await auth.signInWithEmailAndPassword(vEmail, pw);
                }
            } catch(e) {
                console.error("Auth Error:", e);
                if (e.code === 'auth/invalid-credential' || e.code === 'auth/wrong-password' || e.code === 'auth/user-not-found') {
                    errorEl.innerText = "닉네임 또는 비밀번호가 올바르지 않습니다.";
                } else if (e.code === 'auth/email-already-in-use') {
                    errorEl.innerText = "이미 존재하는 닉네임입니다. 로그인을 이용해주세요.";
                } else if (e.code === 'auth/weak-password') {
                    errorEl.innerText = "비밀번호는 6자리 이상이어야 합니다.";
                } else {
                    errorEl.innerText = "오류: " + e.message;
                }
            }
        }

        function logout() { 
            auth.signOut().then(() => location.reload()); 
        }

        // 로그인 상태 감지 시 DB 조회를 기다리지 않고 즉시 화면 전환 (멈춤 방지)
        auth.onAuthStateChanged((user) => {
            const authScr = document.getElementById('auth-screen');
            const mainScr = document.getElementById('main-system');

            if(user) {
                authScr.classList.add('hidden');
                mainScr.classList.remove('hidden');

                // 유저 닉네임 추출 및 화면 세팅
                const nickname = user.email ? user.email.split('@')[0] : '클원';
                document.getElementById('user-info').innerText = `${nickname} (admin)`;
                
                // 관리자 메뉴는 항상 보이도록 처리 (편의성)
                document.getElementById('admin-menu').classList.remove('hidden');

                // 공지사항 불러오기
                db.collection('settings').doc('notice').onSnapshot(d => {
                    document.getElementById('notice-display').innerText = d.exists ? d.data().text : "등록된 공지사항이 없습니다.";
                }, err => {
                    console.log("Notice error:", err);
                });
            } else {
                authScr.classList.remove('hidden');
                mainScr.classList.add('hidden');
            }
        });

        function showTab(id) {
            document.querySelectorAll('.tab-content').forEach(s => s.classList.add('hidden'));
            document.getElementById('tab-' + id).classList.remove('hidden');
        }

        async function saveNotice() {
            const text = document.getElementById('notice-input').value.trim();
            if(!text) return alert("공지 내용을 입력해주세요.");
            try {
                await db.collection('settings').doc('notice').set({ text: text });
                alert("공지사항이 저장되었습니다.");
                document.getElementById('notice-input').value = '';
            } catch(e) {
                alert("저장 실패: 권한이 없거나 오류가 발생했습니다.");
                console.error(e);
            }
        }
    </script>
</body>
</html>
